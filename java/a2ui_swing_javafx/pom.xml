<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.a2ui</groupId>
    <artifactId>a2ui-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>a2ui-java-swing-javafx</artifactId>

  <name>A2UI Java Swing JavaFX Media</name>
  <description>Optional media player for the Swing adapter of the A2UI Java client SDK. It plays the video and the audio of a surface with JavaFX.</description>

  <properties>
    <a2ui.repoRoot>${project.basedir}/../..</a2ui.repoRoot>
    <!--
      A test with the tag "javafx" starts the JavaFX toolkit and plays a media file. It needs a
      display. Thus the usual build does not run it. The profile "javafx-it" runs only those tests.
    -->
    <a2ui.test.excludedGroups>performance,javafx</a2ui.test.excludedGroups>
    <a2ui.javafx.test.headless>-Djava.awt.headless=true</a2ui.javafx.test.headless>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.a2ui</groupId>
      <artifactId>a2ui-java-swing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      OpenJFX has the license GPL-2.0 with the Classpath exception. These two artifacts bring
      javafx-base and javafx-graphics, each with the native code of the computer that runs the
      build.
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The JSON Schema validator of the core brings slf4j-api. This provider discards the log output
      of the tests. Without a provider, SLF4J prints a warning in each test run.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            The tests need no display. Thus they also run on a build server. The tests also do not
            use the network: the proxy settings send each HTTP request to a closed port of this
            computer. An address of this computer does not use the proxy.
          -->
          <argLine>${a2ui.javafx.test.headless} -Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=9 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=9</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Runs only the tests that play media with the JavaFX toolkit, on a computer with a display:
        ./mvnw -pl a2ui_swing_javafx -am -Pjavafx-it verify
      -->
      <id>javafx-it</id>
      <properties>
        <a2ui.test.groups>javafx</a2ui.test.groups>
        <a2ui.test.excludedGroups></a2ui.test.excludedGroups>
        <a2ui.javafx.test.headless>-Djava.awt.headless=false</a2ui.javafx.test.headless>
      </properties>
    </profile>
  </profiles>
</project>
