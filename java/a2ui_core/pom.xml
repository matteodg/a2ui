<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.a2ui</groupId>
    <artifactId>a2ui-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>a2ui-java-core</artifactId>

  <name>A2UI Java Core</name>
  <description>State model and protocol logic of the A2UI Java client SDK. It has no UI code.</description>

  <properties>
    <a2ui.repoRoot>${project.basedir}/../..</a2ui.repoRoot>
  </properties>

  <dependencies>
    <!-- Unicode properties for the UAX #31 identifiers. -->
    <dependency>
      <groupId>com.ibm.icu</groupId>
      <artifactId>icu4j</artifactId>
    </dependency>
    <!-- The JSON parser for the documents in the resources. It is not in the public API. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The conformance suites need a YAML 1.2 parser. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
