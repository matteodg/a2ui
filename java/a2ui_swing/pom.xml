<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.google.a2ui</groupId>
    <artifactId>a2ui-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>a2ui-java-swing</artifactId>

  <name>A2UI Java Swing</name>
  <description>Swing adapter of the A2UI Java client SDK. It shows the surfaces of the core with Swing components.</description>

  <properties>
    <a2ui.repoRoot>${project.basedir}/../..</a2ui.repoRoot>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.a2ui</groupId>
      <artifactId>a2ui-java-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The conformance suites need a YAML 1.2 parser. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The JSON Schema validator of the core brings slf4j-api. This provider discards the log output
      of the tests. Without a provider, SLF4J prints a warning in each test run.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <!--
                The conformance harness examines the messages for the agent with the JSON Schema
                engine of the core, as the tests of the core do. The engine is not a part of the
                API of the core. Thus only the test compilation gets its package.
              -->
              <compilerArgs combine.children="append">
                <arg>--add-exports</arg>
                <arg>com.google.a2ui.core/com.google.a2ui.core.internal=com.google.a2ui.swing</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The tests need no display. Thus they also run on a build server. -->
          <argLine>-Djava.awt.headless=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
